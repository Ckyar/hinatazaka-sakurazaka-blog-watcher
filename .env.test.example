# 複製成 .env.test 後填入正式 POKA Token。測試前必須先停止 Raspberry Pi 服務，
# 且測試完成後必須先關閉 Windows 程序，再重新啟動 Raspberry Pi。
DISCORD_BOT_TOKEN=請填入Bot_Token

# 隔離 Windows 測試：不啟動舊有部落格與成員關注功能
HINATA_ENABLE_WATCHER=false
HINATA_DISCORD_CHANNEL_ID=0
SAKURA_ENABLE_WATCHER=false
SAKURA_DISCORD_CHANNEL_ID=0
ENABLE_SUBSCRIPTION_GUI=false
ENABLE_TEXT_SUBSCRIPTION_COMMANDS=false
SUBSCRIPTION_CHANNEL_ID=0
SUBSCRIPTION_DB=data-test/subscriptions.db

# 只在私人測試頻道啟用東橫監視器
ENABLE_TOYOKO_WATCHER=true
TOYOKO_CHANNEL_ID=請填入測試頻道ID
TOYOKO_DB=data-test/toyoko_watcher.db
TOYOKO_DEFAULT_MIN_INTERVAL_SECONDS=600
TOYOKO_DEFAULT_MAX_INTERVAL_SECONDS=900
TOYOKO_MIN_ALLOWED_INTERVAL_SECONDS=600
TOYOKO_REQUEST_GAP_SECONDS=3
TOYOKO_RULE_GAP_SECONDS=30
TOYOKO_MAX_RULES_PER_USER=5
PIN_TOYOKO_PANEL=true

SAVE_IMAGES_LOCALLY=false
HTTP_TIMEOUT_SECONDS=20
HTTP_RETRIES=3
USER_AGENT=POKA/1.0 (+personal Discord notifier)
LOG_FILE=logs/watcher-test.log
LOG_LEVEL=INFO
STATUS_LOG_INTERVAL_SECONDS=300
DISCORD_HISTORY_LIMIT=500
