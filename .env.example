# Discord Developer Portal 建立的 Bot Token（不要加引號、不要提交到 Git）
DISCORD_BOT_TOKEN=請填入Bot_Token
# 開啟 Discord 開發者模式後，對目標文字頻道按右鍵取得 ID
HINATA_DISCORD_CHANNEL_ID=123456789012345678
# 櫻坂46通知頻道
SAKURA_DISCORD_CHANNEL_ID=123456789012345679

# 指定成員發文時要 Tag 的 Discord 使用者 ID；必須是單行 JSON，未使用時保留 {}
# 一位成員可 Tag 多人，例如 {"高井 俐香":["111111111111111111","222222222222222222"]}
HINATA_MEMBER_MENTIONS={}
# 例如 {"佐藤 愛桜":["333333333333333333"]}
SAKURA_MEMBER_MENTIONS={}

# 成員訂閱指令頻道；填入新開的 Discord 頻道 ID，0 或留白表示停用
SUBSCRIPTION_CHANNEL_ID=0
# 訂閱資料庫（依 guild、使用者與團體成員保存關注關係）
SUBSCRIPTION_DB=data/subscriptions.db
# 官方成員名單快取時間；到期後下一個訂閱指令會重新讀取官方頁面
MEMBER_CATALOG_REFRESH_SECONDS=3600

# 每 15 秒讀取一次官方部落格首頁，直接取得實際存在的文章 ID
HINATA_CHECK_INTERVAL_SECONDS=30
# 櫻坂46首頁輪詢間隔；兩個監控會錯開啟動
SAKURA_CHECK_INTERVAL_SECONDS=30

# HTTP 設定
HTTP_TIMEOUT_SECONDS=20
HTTP_RETRIES=3
USER_AGENT=SakamichiBlogWatcher/1.0 (+personal Discord notifier)

# SQLite 狀態檔與記錄檔（相對路徑以程式目錄為準）
HINATA_STATE_DB=data/watcher.db
# Raspberry Pi 儲存空間有限時設為 false；Bot 仍會把官方圖片網址傳到 Discord
SAVE_IMAGES_LOCALLY=true
# 圖片會儲存成 images/成員名字/日期_部落格標題_ID/圖片檔
HINATA_IMAGE_DIR=images/日向坂46
# 櫻坂46使用獨立資料庫與圖片資料夾，避免文章 ID 衝突
SAKURA_STATE_DB=data/sakura_watcher.db
SAKURA_IMAGE_DIR=images/櫻坂46
LOG_FILE=logs/watcher.log
LOG_LEVEL=INFO
# 沒有新文章時，每 5 分鐘才記錄一次狀態，降低 Raspberry Pi SD 卡寫入
STATUS_LOG_INTERVAL_SECONDS=300

# 本地 SQLite 狀態遺失時，最多往回檢查幾則 Discord 訊息以避免重傳
DISCORD_HISTORY_LIMIT=500
